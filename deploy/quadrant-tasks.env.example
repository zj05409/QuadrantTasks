# Environment for quadrant-tasks (systemd EnvironmentFile)
QUADRANT_DATA_DIR=/var/lib/quadrant-tasks

# Legacy single-user token -> user "default" (data stays in tasks.json).
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# Optional once you manage users with `python -m server.admin`.
QUADRANT_TOKEN=change-me

# Allow the GitHub Pages front end (or any other origin) to call the API.
# Comma-separated, scheme + host only, no trailing slash.
#QUADRANT_CORS_ORIGINS=https://zj05409.github.io

# Enable self sign-up in the app's settings screen. Share the code only with
# people you want on this server; unset it to close registration.
#QUADRANT_INVITE_CODE=pick-a-long-random-code
